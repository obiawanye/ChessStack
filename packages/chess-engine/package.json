{
  "name": "@chessstack/chess-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Chess parsing and Stockfish analysis engine for ChessStack",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
